# Public browser values. Use the deployed Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Preferred Supabase key. Do not define both this and the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only for projects that have not migrated to a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used only by validated Route Handlers for derived AI/rules
# records whose tables intentionally have no authenticated write policy.
SUPABASE_SERVICE_ROLE_KEY=
# Explicitly enables synthetic F08 UI fixtures locally. Leave false/unset for
# real persistence testing and every deployed environment.
NEXT_PUBLIC_NEUROCARE_DEMO_MODE=false
# AI-Neurocare Gateway. Both variables are server-only: never add
# NEXT_PUBLIC_ prefixes and never read them from Client Components.
AI_GATEWAY_BASE_URL=https://ai-neurocare-gateway-727279561989.asia-southeast2.run.app
# Required only when the Gateway deployment configures GATEWAY_API_KEYS.
# Leave blank only for a deliberately unauthenticated private/dev Gateway.
AI_GATEWAY_API_KEY=
# Enables forwarding only for the reviewed capture contract; camera capture
# remains disabled until the Gateway PPG proxy is operational.
PPG_CAPTURE_CONTRACT_VERSION=ppg-camera-v1
# Required only when F06 Motion Rehab is enabled on a deployment.
NEXT_PUBLIC_MEDIAPIPE_WASM_PATH=
NEXT_PUBLIC_POSE_LANDMARKER_MODEL_PATH=
# P2 backlog. Keep false until product, speech-specialist, privacy, and accessibility review.
FEATURE_F09_COMMUNICATION_REHAB=false
# P2 backlog. Keep false until clinician/research, privacy, and accessibility review.
FEATURE_F10_COGNITIVE_ACTIVITIES=false
# P2 backlog. Keep false until sharing policy, ACL/RLS, and delivery provider are approved.
FEATURE_F11_CAREGIVER_REMINDERS=false
# Used only by `npm run test:rls`; never commit credentials.
RLS_TEST_USER_A_EMAIL=
RLS_TEST_USER_A_PASSWORD=
RLS_TEST_USER_B_EMAIL=
RLS_TEST_USER_B_PASSWORD=
